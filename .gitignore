# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Secrets. .env holds AUTH_PASSWORD_HASH; the wildcard catches the tmp/bak
# variants that editors and shell redirects leave behind.
.env
.env.*
!.env.example

# Node
node_modules/
.next/
out/
npm-debug.log*

# macOS
.DS_Store

# Scheduled backups. Full copies of the ledger -- they must never be committed,
# and they land here by default (BACKUP_DIR).
backups/
backend/backups/
*.json.tmp
