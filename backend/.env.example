DATABASE_URL=postgresql+psycopg://localhost/budgetapp
TEST_DATABASE_URL=postgresql+psycopg://localhost/budgetapp_test
ECHO_SQL=false

# --- Assisted categorisation and receipt reading (optional) ------------------
# Off by default. "none" | "openai_compatible" | "anthropic".
# A key left in this file does NOT switch anything on -- the provider does.
LLM_PROVIDER=none

# openai_compatible covers Ollama, Groq, OpenRouter, Together, LM Studio.
#
#   Local, free, private -- nothing leaves the machine, no key:
#     brew install ollama && ollama serve
#     ollama pull llama3.2 && ollama pull llama3.2-vision
#     LLM_PROVIDER=openai_compatible
#     LLM_BASE_URL=http://localhost:11434/v1
#     LLM_MODEL=llama3.2
#     LLM_VISION_MODEL=llama3.2-vision
#
#   Groq (free tier, fast):
#     LLM_BASE_URL=https://api.groq.com/openai/v1
#     LLM_API_KEY=gsk_...
#     LLM_MODEL=llama-3.3-70b-versatile
#
#   OpenRouter (has :free models):
#     LLM_BASE_URL=https://openrouter.ai/api/v1
#     LLM_API_KEY=sk-or-...
#
# Merchant names are a spending profile. Local keeps them local.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL=llama3.2
LLM_VISION_MODEL=llama3.2-vision
